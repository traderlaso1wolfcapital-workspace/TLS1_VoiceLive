<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Reference Include="TLS1.Core">
      <HintPath>lib\TLS1.Core.dll</HintPath>
    </Reference>
    <Reference Include="TLS1.Application">
      <HintPath>lib\TLS1.Application.dll</HintPath>
    </Reference>
    <Reference Include="TLS1.Infrastructure">
      <HintPath>lib\TLS1.Infrastructure.dll</HintPath>
    </Reference>
    <Reference Include="TLS1.AI">
      <HintPath>lib\TLS1.AI.dll</HintPath>
    </Reference>
    <Reference Include="TLS1.Chat">
      <HintPath>lib\TLS1.Chat.dll</HintPath>
    </Reference>
    <Reference Include="NAudio">
      <HintPath>lib\NAudio.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.Core">
      <HintPath>lib\NAudio.Core.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.WinMM">
      <HintPath>lib\NAudio.WinMM.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.Wasapi">
      <HintPath>lib\NAudio.Wasapi.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.Asio">
      <HintPath>lib\NAudio.Asio.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.Midi">
      <HintPath>lib\NAudio.Midi.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.WinForms">
      <HintPath>lib\NAudio.WinForms.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>