<Window x:Class="TLS1.VoiceLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TLS1.VoiceLive.Models"
        xmlns:local="clr-namespace:TLS1.VoiceLive"
        Title="TLS1 Voice Live - Đọc bình luận livestream"
        Width="1000" Height="840"
        MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- ── BUTTON BASE ── -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFAA00"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TEXTBOX ── -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFAA00"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionBrush" Value="#FFAA00"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFAA00"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── COMBOBOX ── -->
        <ControlTemplate x:Key="CbToggle" TargetType="ToggleButton">
            <Border x:Name="bd" Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,24,0"/>
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                          Data="M0,0L4,4L8,0" Stroke="#AAAAAA" StrokeThickness="1.5"
                          Fill="Transparent" Margin="0,0,8,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#FFAA00"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="CbTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" Template="{StaticResource CbToggle}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="8,4,28,4" VerticalAlignment="Center"/>
                <Popup x:Name="Popup" Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False">
                    <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                        <Border Background="#2D2D2D" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="4"/>
                        <ScrollViewer Margin="2" Background="#2D2D2D">
                            <StackPanel IsItemsHost="True"/>
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource CbTemplate}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent"
                                            Padding="{TemplateBinding Padding}" CornerRadius="3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                            <Setter Property="Foreground" Value="#FFAA00"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── LISTBOX ITEM ── -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CHECKBOX ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── SECTION CARD (nổi khối rõ) ── -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8,0,8,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Section header bar -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="5,5,0,0"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <!-- Section body -->
        <Style x:Key="SectionBody" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <!-- STOP button (Khi active/bắt đầu chạy sẽ hiện màu đỏ nhẹ mềm mại) -->
        <Style x:Key="BtnStopStyle" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- ROOT GRID                                              -->
    <!-- ══════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>    <!-- 0: Titlebar -->
            <RowDefinition Height="Auto"/>  <!-- 1: Source section -->
            <RowDefinition Height="Auto"/>  <!-- 2: Voice section -->
            <RowDefinition Height="Auto"/>  <!-- 3: Clone/Slang section -->
            <RowDefinition Height="Auto"/>  <!-- 4: Control bar -->
            <RowDefinition Height="Auto"/>  <!-- 5: Status bar -->
            <RowDefinition Height="*"/>     <!-- 6: Chat log -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 0. TITLE BAR                                       -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#2D2D2D"
                BorderBrush="#FFAA00" BorderThickness="0,0,0,2">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔊" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="19" FontWeight="Bold">
                        <Run Text="TLS1" Foreground="#FFAA00"/>
                        <Run Text=" Voice Live" Foreground="White"/>
                    </TextBlock>
                    <TextBlock Text=" v2.2" FontSize="11" Foreground="#555555"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
                <TextBlock x:Name="txtCloneStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="#888888"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 1. NGUỒN LIVESTREAM                               -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="8,8,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="Auto"/>  <!-- input row -->
                    <RowDefinition Height="Auto"/>  <!-- source list -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📡 " FontSize="13"/>
                        <TextBlock Text="NGUỒN LIVESTREAM" Foreground="#FFAA00"
                                   FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="  — Thêm YouTube, TikTok, Twitch..." 
                                   Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Input row -->
                <Border Grid.Row="1" Style="{StaticResource SectionBody}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Nền tảng:" Foreground="#888888"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="cbPlatform"
                                  ItemsSource="{Binding AvailablePlatforms}"
                                  SelectedItem="{Binding SelectedPlatform}"
                                  Height="32"
                                  SelectionChanged="CbPlatform_SelectionChanged"/>
                        <TextBlock Grid.Column="2" Text="Kênh / ID:" Foreground="#888888"
                                   FontSize="13" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <TextBox Grid.Column="3"
                                 Text="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" VerticalContentAlignment="Center"
                                 ToolTip="Tên kênh, Video ID, Room ID..."/>
                        <TextBlock Grid.Column="4" Text="URL / Link:" Foreground="#888888"
                                   FontSize="13" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <TextBox Grid.Column="5"
                                 Text="{Binding LivestreamUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" VerticalContentAlignment="Center"
                                 TextChanged="TxtLivestreamUrl_TextChanged"
                                 ToolTip="Dán link YouTube/TikTok hoặc wss://..."/>
                        <!-- Help button -->
                        <Button Grid.Column="6" Content="?" Width="30" Height="30"
                                Background="#333333" Foreground="#FFAA00"
                                FontWeight="Bold" FontSize="14"
                                Style="{StaticResource BtnBase}"
                                Padding="0" Margin="4,0,0,0"
                                Click="BtnHelp_Click" ToolTip="Hướng dẫn lấy URL"/>
                        <!-- Add source button -->
                        <Button Grid.Column="7"
                                Content="＋  Thêm nguồn"
                                Height="30" Padding="14,4"
                                Background="#2E7D32" Foreground="White"
                                FontWeight="Bold" FontSize="12"
                                Style="{StaticResource BtnBase}"
                                Margin="6,0,0,0"
                                Command="{Binding AddSourceCommand}"/>
                    </Grid>
                </Border>

                <!-- Source list (luôn hiển thị, tự ẩn khi rỗng qua MinHeight) -->
                <Border Grid.Row="2"
                        Background="#1A1A1A"
                        CornerRadius="0,0,5,5"
                        Padding="10,6"
                        MinHeight="0">
                    <ItemsControl ItemsSource="{Binding LiveSources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LiveSource}">
                                <Border Background="#2D2D2D" CornerRadius="4"
                                        Padding="10,5" Margin="0,0,0,4"
                                        BorderBrush="#3A3A3A" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayText}"
                                                   Foreground="#CCCCCC" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="✕" Width="22" Height="22"
                                                Background="#CC2222" Foreground="White"
                                                FontSize="11" FontWeight="Bold"
                                                Style="{StaticResource BtnBase}"
                                                Padding="0"
                                                Click="BtnRemoveSource_Click"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 2. GIỌNG ĐỌC & CLONE / SLANG (SIDE BY SIDE)        -->
        <!-- ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 2A. GIỌNG ĐỌC / TTS -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="8,0,4,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗣 " FontSize="13"/>
                            <TextBlock Text="GIỌNG ĐỌC" Foreground="#FFAA00"
                                       FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SectionBody}">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Giọng đọc:" Foreground="#888888"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableVoices}"
                                          SelectedValue="{Binding SelectedVoiceId}"
                                          SelectedValuePath="Id" Height="30"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mẫu câu:" Foreground="#888888"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding PrefixTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30" VerticalContentAlignment="Center"
                                         ToolTip="VD: [{Platform}] {Username} nói: "/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2B. CLONE GIỌNG + SLANG -->
            <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="4,0,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎤 " FontSize="13"/>
                            <TextBlock Text="CLONE GIỌNG &amp; SLANG" Foreground="#FFAA00"
                                       FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SectionBody}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Clone row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Clone:" Foreground="#888888"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="📁 File MP3"
                                        Height="28" Padding="8,4"
                                        Background="#333333" Foreground="#CCCCCC"
                                        FontSize="11" Style="{StaticResource BtnBase}"
                                        Click="BtnBrowseAudio_Click"/>
                                <TextBox Grid.Column="2" x:Name="txtCloneFilePath"
                                         Height="28" VerticalContentAlignment="Center"
                                         FontSize="11" Margin="6,0"
                                         IsReadOnly="True" Text="Chưa chọn file"
                                         Foreground="#555555"/>
                                <Button Grid.Column="3" x:Name="btnCloneVoice"
                                        Content="▶ Clone"
                                        Height="28" Padding="10,4"
                                        Background="#2E7D32" Foreground="White"
                                        FontSize="11" FontWeight="Bold"
                                        Style="{StaticResource BtnBase}"
                                        IsEnabled="False" Click="BtnCloneVoice_Click"/>
                                <Button Grid.Column="4" x:Name="btnClearClone"
                                        Content="✕ Xóa"
                                        Height="28" Padding="8,4"
                                        Background="#CC2222" Foreground="White"
                                        FontSize="11" FontWeight="Bold"
                                        Style="{StaticResource BtnBase}"
                                        Margin="4,0,0,0" Click="BtnClearClone_Click"/>
                            </Grid>

                            <!-- API Key row -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkShowApiKey" Grid.Column="0"
                                          Content="🔑 API Key (ElevenLabs 10k/tháng)"
                                          Checked="ChkShowApiKey_Changed"
                                          Unchecked="ChkShowApiKey_Changed"/>
                                <TextBox Grid.Column="1" x:Name="txtCloneApiKey"
                                         Height="26" VerticalContentAlignment="Center"
                                         FontSize="11" Margin="8,0,0,0"
                                         Visibility="Collapsed"/>
                            </Grid>

                            <!-- Slang row -->
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Slang:" Foreground="#888888"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="txtSlangKey"
                                         Height="26" FontSize="11" VerticalContentAlignment="Center"
                                         ToolTip="Từ viết tắt: ae, ko, mí..."/>
                                <TextBlock Grid.Column="2" Text=" → " Foreground="#555555"
                                           FontSize="13" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="3" x:Name="txtSlangValue"
                                         Height="26" FontSize="11" VerticalContentAlignment="Center"
                                         ToolTip="Cách đọc đầy đủ: anh em, không, mấy..."/>
                                <Button Grid.Column="4" Content="＋"
                                        Width="30" Height="26" Padding="0"
                                        Background="#FFAA00" Foreground="#1A1A1A"
                                        FontWeight="Bold" FontSize="15"
                                        Style="{StaticResource BtnBase}"
                                        Margin="4,0,0,0"
                                        Click="BtnAddSlang_Click"
                                        ToolTip="Thêm slang vào từ điển"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 4. CONTROL BAR                                     -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Margin="8,0,8,8"
                Background="#2D2D2D" CornerRadius="6"
                BorderBrush="#3D3D3D" BorderThickness="1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="▶  BẮT ĐẦU"
                        Width="130" Height="36"
                        Background="#2E7D32" Foreground="White"
                        FontWeight="Bold" FontSize="14"
                        Style="{StaticResource BtnBase}"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="1"
                        Content="⏹  DỪNG"
                        Width="110" Height="36"
                        Style="{StaticResource BtnStopStyle}"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding IsRunning}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="2" x:Name="btnMute"
                        Content="🔊" Width="40" Height="36"
                        Background="#333333" Foreground="#E0E0E0"
                        FontSize="16" Padding="0"
                        Style="{StaticResource BtnBase}"
                        Margin="0,0,8,0"
                        Click="BtnMute_Click" ToolTip="Tắt/Mở âm thanh"/>

                <Button Grid.Column="3"
                        Content="🗑 Xóa log"
                        Height="36" Padding="14,6"
                        Background="#333333" Foreground="#CCCCCC"
                        FontSize="12"
                        Style="{StaticResource BtnBase}"
                        Command="{Binding ClearLogCommand}"/>

                <!-- Stats -->
                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <TextBlock Text="📊 " Foreground="#555555" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MessageCount}"
                               FontWeight="Bold" Foreground="#FFAA00"
                               FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text=" bình luận" Foreground="#555555"
                               FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 5. STATUS BAR                                      -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="5" Margin="8,0,8,6"
                Background="#1E1E1E" CornerRadius="4"
                Padding="12,6">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#00CC66" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ConnectedPlatformsText}"
                           FontSize="12" Foreground="#666666"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 6. CHAT LOG                                        -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="6" Style="{StaticResource SectionCard}" Margin="8,0,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬 " FontSize="13"/>
                        <TextBlock Text="CHAT LOG" Foreground="#FFAA00"
                                   FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ChatLog}"
                         Background="#1A1A1A"
                         Foreground="#CCCCCC"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,3" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding DisplayText}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#CCCCCC" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>