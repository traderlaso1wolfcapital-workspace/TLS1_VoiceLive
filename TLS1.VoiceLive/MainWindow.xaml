<Window x:Class="TLS1.VoiceLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TLS1.VoiceLive.Models"
        xmlns:local="clr-namespace:TLS1.VoiceLive"
        Title="TLS1 Voice Live - Đọc bình luận livestream"
        Width="1000" Height="840"
        MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F121C"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- ── BUTTON BASE ── -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F59E0B"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#222A3C"/>
                                <Setter Property="Foreground" Value="#525E75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TEXTBOX (Inset lõm sâu vào card) ── -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#111622"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#38455E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#F59E0B"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionBrush" Value="#F59E0B"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── COMBOBOX ── -->
        <ControlTemplate x:Key="CbToggle" TargetType="ToggleButton">
            <Border x:Name="bd" Background="#111622" BorderBrush="#38455E" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,24,0"/>
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                          Data="M0,0L4,4L8,0" Stroke="#94A3B8" StrokeThickness="1.5"
                          Fill="Transparent" Margin="0,0,8,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#F59E0B"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="CbTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" Template="{StaticResource CbToggle}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="8,4,28,4" VerticalAlignment="Center"/>
                <Popup x:Name="Popup" Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False">
                    <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                        <Border Background="#1C2333" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4"/>
                        <ScrollViewer Margin="2" Background="#1C2333">
                            <StackPanel IsItemsHost="True"/>
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource CbTemplate}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F1F5F9"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent"
                                            Padding="{TemplateBinding Padding}" CornerRadius="3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2D374D"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2D374D"/>
                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── LISTBOX ITEM ── -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C2333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CHECKBOX ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── SECTION CARD ── -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#1C2333"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8,0,8,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#38455E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Section header bar -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#252E42"/>
            <Setter Property="BorderBrush" Value="#38455E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="5,5,0,0"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <!-- Section body -->
        <Style x:Key="SectionBody" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- STOP button (Màu đỏ chuẩn trading) -->
        <Style x:Key="BtnStopStyle" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#222A3C"/>
                    <Setter Property="Foreground" Value="#525E75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── TAB HEADER BUTTON ── -->
        <Style x:Key="BtnTabHeader" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- ROOT GRID                                              -->
    <!-- ══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>    <!-- 0: Titlebar -->
            <RowDefinition Height="Auto"/>  <!-- 1: Nguồn livestream -->
            <RowDefinition Height="Auto"/>  <!-- 2: Control bar -->
            <RowDefinition Height="*"/>     <!-- 3: Unified Main Card (Tabs + Status + Content) -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 0. TITLE BAR                                       -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0F121C"
                BorderBrush="#262E3F" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔊" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="19" FontWeight="Bold">
                        <Run Text="TLS1" Foreground="#F59E0B"/>
                        <Run Text=" Voice Live" Foreground="White"/>
                    </TextBlock>
                    <TextBlock Text=" v2.2" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtCloneStatus" VerticalAlignment="Center"
                               FontSize="12" Foreground="#94A3B8" Margin="0,0,16,0"/>

                    <!-- 🌐 BỘ CHỌN NGÔN NGỮ (VI / EN / ZH / JA / KO) -->
                    <Border Background="#1C2333" BorderBrush="#38455E" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center" Margin="2,0,6,0"/>
                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      Width="135" Height="26"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="12" FontWeight="SemiBold"
                                      VerticalContentAlignment="Center"
                                      ToolTip="Chọn ngôn ngữ giao diện &amp; giọng đọc (Language)"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                           FontSize="12" Foreground="#94A3B8"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 1. NGUỒN LIVESTREAM                               -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="8,8,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="Auto"/>  <!-- input row -->
                    <RowDefinition Height="Auto"/>  <!-- source list -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📡 " FontSize="13"/>
                        <TextBlock Text="{Binding UiPlatformHeader}" Foreground="#F59E0B"
                                   FontSize="12" FontWeight="Bold"/>
                                   Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Input row -->
                <Border Grid.Row="1" Style="{StaticResource SectionBody}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding UiPlatformLabel}" Foreground="#94A3B8"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="cbPlatform"
                                  ItemsSource="{Binding AvailablePlatforms}"
                                  SelectedItem="{Binding SelectedPlatform}"
                                  Height="32"
                                  SelectionChanged="CbPlatform_SelectionChanged"/>
                        <TextBlock Grid.Column="2" Text="{Binding UiChannelLabel}" Foreground="#94A3B8"
                                   FontSize="13" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <TextBox Grid.Column="3"
                                 Text="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" VerticalContentAlignment="Center"
                                 ToolTip="Tên kênh, Video ID, Room ID..."/>
                        <TextBlock Grid.Column="4" Text="{Binding UiUrlLabel}" Foreground="#94A3B8"
                                   FontSize="13" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <TextBox Grid.Column="5"
                                 Text="{Binding LivestreamUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" VerticalContentAlignment="Center"
                                 TextChanged="TxtLivestreamUrl_TextChanged"
                                 ToolTip="Dán link YouTube/TikTok hoặc wss://..."/>
                        <!-- Help button -->
                        <Button Grid.Column="6" Content="?" Width="30" Height="30"
                                Background="#262F42" Foreground="#F59E0B"
                                BorderBrush="#38455E" BorderThickness="1"
                                FontWeight="Bold" FontSize="14"
                                Style="{StaticResource BtnBase}"
                                Padding="0" Margin="4,0,0,0"
                                Click="BtnHelp_Click" ToolTip="Hướng dẫn lấy URL"/>
                        <!-- Add source button -->
                        <Button Grid.Column="7"
                                Content="{Binding UiAddSource}"
                                Height="30" Padding="14,4"
                                Background="#10B981" Foreground="White"
                                FontWeight="Bold" FontSize="12"
                                Style="{StaticResource BtnBase}"
                                Margin="6,0,0,0"
                                Command="{Binding AddSourceCommand}"/>
                    </Grid>
                </Border>

                <!-- Source list (luôn hiển thị, tự ẩn khi rỗng qua MinHeight) -->
                <Border Grid.Row="2"
                        Background="#111622"
                        CornerRadius="0,0,5,5"
                        Padding="10,6"
                        MinHeight="0">
                    <ItemsControl ItemsSource="{Binding LiveSources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LiveSource}">
                                <Border Background="#1C2333" CornerRadius="4"
                                        Padding="10,5" Margin="0,0,0,4"
                                        BorderBrush="#38455E" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayText}"
                                                   Foreground="#F1F5F9" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="✕" Width="22" Height="22"
                                                Background="#EF4444" Foreground="White"
                                                FontSize="11" FontWeight="Bold"
                                                Style="{StaticResource BtnBase}"
                                                Padding="0"
                                                Click="BtnRemoveSource_Click"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 2. CONTROL BAR                                     -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="8,0,8,8"
                Background="#1C2333" CornerRadius="6"
                BorderBrush="#38455E" BorderThickness="1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{Binding UiStart}"
                        Width="130" Height="36"
                        Background="#10B981" Foreground="White"
                        FontWeight="Bold" FontSize="14"
                        Style="{StaticResource BtnBase}"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="1"
                        Content="{Binding UiStop}"
                        Width="110" Height="36"
                        Style="{StaticResource BtnStopStyle}"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding IsRunning}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="2" x:Name="btnMute"
                        Content="🔊" Width="40" Height="36"
                        Background="#262F42" BorderBrush="#38455E" BorderThickness="1"
                        Foreground="#F1F5F9"
                        FontSize="16" Padding="0"
                        Style="{StaticResource BtnBase}"
                        Margin="0,0,8,0"
                        Click="BtnMute_Click" ToolTip="Tắt/Mở âm thanh"/>

                <Button Grid.Column="3" x:Name="btnAiReply"
                        Height="36" Padding="12,6"
                        Background="#262F42" BorderBrush="#38455E" BorderThickness="1"
                        Foreground="#F1F5F9"
                        Style="{StaticResource BtnBase}"
                        Margin="0,0,8,0"
                        Click="BtnToggleAiReply_Click"
                        ToolTip="Bật/Tắt chế độ AI tự động trả lời comment (9Router Mac Mini)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtAiIcon" Text="🤖" FontSize="14" Margin="0,0,6,0" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtAiLabel" Text="{Binding UiAiReply}" FontWeight="Bold" FontSize="12" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Content="{Binding UiClearLog}"
                        Height="36" Padding="14,6"
                        Background="#262F42" BorderBrush="#38455E" BorderThickness="1"
                        Foreground="#F1F5F9"
                        FontSize="12"
                        Style="{StaticResource BtnBase}"
                        Margin="0,0,8,0"
                        Command="{Binding ClearLogCommand}"/>

                <!-- Stats -->
                <StackPanel Grid.Column="5" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <TextBlock Text="📊 " Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MessageCount}"
                               FontWeight="Bold" Foreground="#F59E0B"
                               FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UiCommentsCountSuffix}" Foreground="#94A3B8"
                               FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- 3. UNIFIED MAIN CARD (TABS + STATUS + CONTENT)      -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="8,0,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>  <!-- Unified Header: Tabs + Status -->
                    <RowDefinition Height="*"/>   <!-- Content view -->
                </Grid.RowDefinitions>

                <!-- ── UNIFIED HEADER: TABS + STATUS TRONG 1 KHỐI DUY NHẤT ── -->
                <Border Grid.Row="0" Style="{StaticResource SectionHeader}" Padding="8,4,14,4">
                    <Grid>
                        <!-- Left: Tab Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnTabChat"
                                    Style="{StaticResource BtnTabHeader}"
                                    Background="#1C2333" BorderBrush="#38455E" BorderThickness="1,1,1,0"
                                    Margin="0,0,6,0"
                                    Click="BtnTabChat_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💬 " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtTabChatLabel" Text="{Binding UiTabChat}" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnTabSettings"
                                    Style="{StaticResource BtnTabHeader}"
                                    Background="Transparent" BorderThickness="0"
                                    Click="BtnTabSettings_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙ " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtTabSettingsLabel" Text="{Binding UiTabSettings}" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: Status Indicators (Gộp từ StatusBar cũ vào đây) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding ConnectedPlatformsText}"
                                       FontSize="12" Foreground="#94A3B8"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── TAB CONTENTS ── -->
                <Grid Grid.Row="1">
                    <!-- TAB 1: CHAT LOG VIEW -->
                    <Grid x:Name="viewChatLog" Visibility="Visible">
                        <ListBox ItemsSource="{Binding ChatLog}"
                                 Background="#0E121B"
                                 Foreground="#F1F5F9"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,3" BorderBrush="#1C2333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="#F1F5F9" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- TAB 2: CÀI ĐẶT VIEW (Giọng đọc & Clone Slang & Prompt AI) -->
                    <Grid x:Name="viewSettings" Visibility="Collapsed" Background="#111622">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ROW 0: 2 Cột Cài đặt Giọng và Clone Slang -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>

                                <!-- 2A. GIỌNG ĐỌC / TTS -->
                                <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗣 " FontSize="13"/>
                                                <TextBlock Text="{Binding UiCardVoiceHeader}" Foreground="#F59E0B"
                                                           FontSize="12" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding UiCardVoiceSub}" Foreground="#94A3B8"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                           FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Style="{StaticResource SectionBody}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding UiVoiceLabel}" Foreground="#94A3B8"
                                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding AvailableVoices}"
                                                              SelectedValue="{Binding SelectedVoiceId}"
                                                              SelectedValuePath="Id" Height="30"/>
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Mẫu câu:" Foreground="#94A3B8"
                                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding PrefixTemplate, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" VerticalContentAlignment="Center"
                                                             ToolTip="VD: [{Platform}] {Username} nói: "/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 2B. CLONE GIỌNG + SLANG -->
                                <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎤 " FontSize="13"/>
                                                <TextBlock Text="{Binding UiCardCloneHeader}" Foreground="#F59E0B"
                                                           FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Style="{StaticResource SectionBody}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Clone row -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding UiCloneLabel}" Foreground="#94A3B8"
                                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="1" Content="{Binding UiBrowseBtn}"
                                                            Height="28" Padding="8,4"
                                                            Background="#262F42" Foreground="#F1F5F9"
                                                            BorderBrush="#38455E" BorderThickness="1"
                                                            FontSize="11" Style="{StaticResource BtnBase}"
                                                            Click="BtnBrowseAudio_Click"/>
                                                    <TextBox Grid.Column="2" x:Name="txtCloneFilePath"
                                                             Height="28" VerticalContentAlignment="Center"
                                                             FontSize="11" Margin="6,0"
                                                             IsReadOnly="True" Text="Chưa chọn file"
                                                             Foreground="#94A3B8"/>
                                                    <Button Grid.Column="3" x:Name="btnCloneVoice"
                                                            Content="▶ Clone"
                                                            Height="28" Padding="10,4"
                                                            Background="#10B981" Foreground="White"
                                                            FontSize="11" FontWeight="Bold"
                                                            Style="{StaticResource BtnBase}"
                                                            IsEnabled="False" Click="BtnCloneVoice_Click"/>
                                                    <Button Grid.Column="4" x:Name="btnClearClone"
                                                            Content="{Binding UiClearCloneBtn}"
                                                            Height="28" Padding="8,4"
                                                            Background="#EF4444" Foreground="White"
                                                            FontSize="11" FontWeight="Bold"
                                                            Style="{StaticResource BtnBase}"
                                                            Margin="4,0,0,0" Click="BtnClearClone_Click"/>
                                                </Grid>

                                                <!-- 2. API Key row (Giãn cách riêng biệt, hiện ô nhập luôn) -->
                                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding UiElevenLabsKeyLabel}" Foreground="#94A3B8"
                                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Column="1" x:Name="txtCloneApiKey"
                                                             Height="28" VerticalContentAlignment="Center"
                                                             FontSize="11"/>
                                                </Grid>

                                                <!-- 3. Slang row (Giãn cách riêng biệt) -->
                                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding UiSlangLabel}" Foreground="#94A3B8"
                                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox Grid.Column="1" x:Name="txtSlangKey"
                                                             Height="28" FontSize="11" VerticalContentAlignment="Center"
                                                             ToolTip="Từ viết tắt: ae, ko, mí..."/>
                                                    <TextBlock Grid.Column="2" Text=" → " Foreground="#94A3B8"
                                                               FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="3" x:Name="txtSlangValue"
                                                             Height="28" FontSize="11" VerticalContentAlignment="Center"
                                                             ToolTip="Cách đọc đầy đủ: anh em, không, mấy..."/>
                                                    <Button Grid.Column="4" Content="＋"
                                                            Width="32" Height="28" Padding="0"
                                                            Background="#F59E0B" Foreground="#0F121C"
                                                            FontWeight="Bold" FontSize="15"
                                                            Style="{StaticResource BtnBase}"
                                                            Margin="4,0,0,0"
                                                            Click="BtnAddSlang_Click"
                                                            ToolTip="Thêm slang vào từ điển"/>
                                                </Grid>

                                                <!-- 4. 9Router AI Slang Normalizer Banner -->
                                                <Border Grid.Row="3" Margin="0,14,0,0" Background="#161F2E" BorderBrush="#2A3850" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="✨ " FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="AI 9Router tự động chuẩn hóa Teencode &amp; Slang mượt mà trước khi phát âm" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                                <!-- ROW 1: PROMPT TRẢ LỜI AI (9Router Mac Mini) -->
                                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🤖 " FontSize="13"/>
                                                    <TextBlock Text="{Binding UiCardPromptHeader}" Foreground="#F59E0B"
                                                               FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding UiPromptDesc}"
                                                               Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button HorizontalAlignment="Right" Content="{Binding UiResetPromptBtn}"
                                                        Height="24" Padding="10,2"
                                                        Background="#262F42" Foreground="#F1F5F9"
                                                        BorderBrush="#38455E" BorderThickness="1"
                                                        FontSize="11" Style="{StaticResource BtnBase}"
                                                        Command="{Binding ResetPromptCommand}"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1" Style="{StaticResource SectionBody}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBox Grid.Row="0"
                                                         Text="{Binding AiSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="85" MaxHeight="160"
                                                         VerticalScrollBarVisibility="Auto"
                                                         FontSize="12" Padding="8,6"
                                                         ToolTip="Nhập prompt chỉ dẫn cho AI trả lời comment"/>
                                                <TextBlock Grid.Row="1" Margin="2,6,0,0"
                                                           Text="💡 Mẹo: Yêu cầu AI trả lời thật ngắn gọn (1 câu, dưới 20 từ), xưng hô thân mật (bác/em), không dùng emoji hay markdown để giọng đọc phát âm mượt mà nhất."
                                                           Foreground="#64748B" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
